# =============================================================================
# Kotoba Tag environment variables
# Copy this file to .env and fill in the required values:
#   cp .env.example .env
# =============================================================================

# --- API server (required for local dev and Render deployment) ----------------

# HuggingFace access token with permission to call the definition model.
# Create one at: https://huggingface.co/settings/tokens
HUGGINGFACE_TOKEN=

# HuggingFace inference endpoint for nphach/jp-parallel-gloss similarity checks.
HF_SIMILARITY_URL=https://api-inference.huggingface.co/models/nphach/jp-parallel-gloss

# --- API server (optional) ----------------------------------------------------

# Skip background model warmup on server startup (faster local boot).
# SKIP_HF_WARMUP=true

# Allow localhost:5173 CORS in non-Render environments (auto-enabled locally).
# ALLOW_LOCALHOST_CORS=true

# --- Frontend (optional) ------------------------------------------------------

# Override the API base URL. In dev, defaults to http://127.0.0.1:8000.
# In production builds, defaults to https://kotoba-tag-server.onrender.com
# unless set here at build time.
# VITE_API_URL=http://127.0.0.1:8000

# --- Data pipeline only (not required to play the game) -----------------------

# Turso credentials for vocab/definition database scripts (drizzle-kit, scrapers).
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=
